<mxfile host="app.diagrams.net" modified="2026-07-07T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram name="Ishikawa - SIM" id="ishikawa-sim">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Ishikawa (Fishbone) Diagram — Causes of Under-Reporting / Delayed Reporting of Campus Security Incidents" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="10" width="1080" height="40" as="geometry" />
        </mxCell>

        <!-- Spine -->
        <mxCell id="spine" style="endArrow=block;html=1;strokeWidth=3;fillColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="spineStart" target="head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="spineStart" value="" style="point;" vertex="1" parent="1">
          <mxGeometry x="150" y="475" width="1" height="1" as="geometry" />
        </mxCell>

        <!-- Head / Problem box -->
        <mxCell id="head" value="Delayed / Under-Reporting of Campus Security Incidents (stabbing, rape, theft, murder, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="415" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- ============ TOP BRANCHES ============ -->
        <!-- People -->
        <mxCell id="bonePeople" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="475" as="sourcePoint" />
            <mxPoint x="180" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boxPeople" value="PEOPLE&#10;• Fear of victimization / retaliation&#10;• Distrust of security personnel or police&#10;• Unawareness of reporting channels&#10;• Bystander apathy / &quot;not my business&quot; attitude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Process -->
        <mxCell id="boneProcess" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="475" as="sourcePoint" />
            <mxPoint x="470" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boxProcess" value="PROCESS / PROCEDURE&#10;• No standardized reporting procedure&#10;• Slow response from campus security&#10;• No feedback / status update to reporter&#10;• Bureaucratic, multi-office reporting chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Technology -->
        <mxCell id="boneTech" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="475" as="sourcePoint" />
            <mxPoint x="820" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boxTech" value="TECHNOLOGY&#10;• No dedicated reporting platform&#10;• Poor network coverage / data cost&#10;• No real-time alert / notification system&#10;• No incident location tracking or mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- ============ BOTTOM BRANCHES ============ -->
        <!-- Environment -->
        <mxCell id="boneEnv" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="475" as="sourcePoint" />
            <mxPoint x="180" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boxEnv" value="ENVIRONMENT&#10;• Poor lighting across campus &amp; hostels&#10;• Isolated off-campus lodges / villas&#10;• Inadequate security personnel patrol&#10;• Porous fencing and uncontrolled access points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="740" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Policy / Management -->
        <mxCell id="bonePolicy" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="475" as="sourcePoint" />
            <mxPoint x="470" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boxPolicy" value="POLICY / MANAGEMENT&#10;• No clear incident escalation policy&#10;• Weak landlord–security collaboration&#10;• No guaranteed anonymity / whistleblower protection&#10;• Insufficient funding for campus security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="800" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Communication -->
        <mxCell id="boneComm" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="475" as="sourcePoint" />
            <mxPoint x="820" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boxComm" value="COMMUNICATION&#10;• Low awareness of emergency hotlines&#10;• Rumour-based, unverified information spread&#10;• Language / literacy barriers&#10;• Weak school–community (town–gown) liaison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="740" width="240" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
